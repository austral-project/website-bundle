{% extends 'Front/Layout/layout.html.twig' %}
{% block body_class %}{{ currentPage.bodyClass|default("") }}{% endblock %}
{% block content_body_side %}
  {% set withoutStructure = true %}
  <div class="guidelines-by-categ">
    {% for categ, guidelines in guidelinesByCateg %}
      <div class="guideline-by-categ-{{ categ }}">
        <span class="title">{{ ("choices.editor_component.guidelineCategory."~categ)|trans({}, "austral") }}</span>
        <div class="guidelines-container">
          {% for guideline in guidelines %}
            <div class="guideline-content">
              {% include "Front/Components/_components.html.twig" with {templateName: "master", componentsTemplate: guideline.componentsTemplate["master"]} %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
{% endblock %}